# Normalize all text files to LF (Unix) line endings.
# Overrides core.autocrlf on Windows checkouts so working tree stays LF.
* text=auto eol=lf

# Source and script files: force LF.
*.sh text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.md text eol=lf
*.upp text eol=lf
*.txt text eol=lf
*.mk text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Binary files (no line-ending conversion, no executable bit).
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.wav binary
*.bin binary
*.a binary
a.out binary